shamefully-hoist=true

# Do NOT enable node-linker=hoisted globally: on Linux it breaks the web
# build (zod types under @multica/core stop being portable, failing the
# `next build` type-check) and memory-balloons desktop packaging. It is
# only needed for the Android native build, which deadlocks CMake/ninja
# under pnpm's default symlink layout ("manifest still dirty after 100
# tries"). Apply it per-job in CI (.github/workflows/release-local.yml,
# `--config.node-linker=hoisted`) or locally with:
#   pnpm install --config.node-linker=hoisted
